VITE_API_URL="http://localhost:3000/api"

# Límites de un registro de horas por día (E6-01). Si faltan o son inválidos,
# se usan los defaults 0.5 y 8 definidos en src/offline/hour-log-rules.ts.
# El repo del backend tiene sus pares HOUR_LOG_MIN/MAX; mantener en sincro.
#VITE_HOUR_LOG_MIN_HOURS_PER_DAY=0.5
#VITE_HOUR_LOG_MAX_HOURS_PER_DAY=8
